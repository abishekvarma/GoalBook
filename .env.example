# Server-side only; never copy this secret into public/config.js
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# PostgreSQL: set a reachable hosted DB host in Vercel (localhost only works locally)
DB_HOST=your-hosted-postgres-host
DB_PORT=5432
DB_NAME=retail_warehouse
DB_USER=postgres
DB_PASS=replace-with-a-rotated-password
DB_SSLMODE=require
